{
  "manifest_version": 3,
  "name": "GOOD Toolbox",
  "version": "1.0.0",
  "description": "Todas as ferramentas da GOOD numa extensão só: Alerta Frágil, NF-e Fulfillment (Magalu+Shopee), Etiquetas Madeira Madeira, Respostas Rápidas ML, Devoluções Bridge e Sessão Shopee.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "clipboardWrite",
    "cookies",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.bling.com.br/*",
    "https://*.bling.com.br/*",
    "https://*.onrender.com/*",
    "https://painelmarketplace.madeiramadeira.com.br/*",
    "https://www.mercadolivre.com.br/*",
    "https://mercadolivre.com.br/*",
    "https://*.shopee.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bling.com.br/vendas.checkout.php*",
        "https://www.bling.com.br/b/vendas.checkout.php*"
      ],
      "js": [
        "ct-fragil.js"
      ]
    },
    {
      "matches": [
        "https://www.bling.com.br/*"
      ],
      "js": [
        "ct-nf.js"
      ]
    },
    {
      "matches": [
        "https://painelmarketplace.madeiramadeira.com.br/*"
      ],
      "js": [
        "ct-mm.js"
      ]
    },
    {
      "matches": [
        "https://www.mercadolivre.com.br/vendas/*",
        "https://mercadolivre.com.br/vendas/*"
      ],
      "js": [
        "ct-respostas.js"
      ],
      "css": [
        "respostas.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://good-devolucoes-x-marketplaces-x-nfsbling.onrender.com/*"
      ],
      "js": [
        "ct-devolucoes.js"
      ]
    }
  ],
  "background": {
    "service_worker": "bg-toolbox.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "GOOD Toolbox"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "good-toolbox@mover-pedidos",
      "strict_min_version": "115.0"
    }
  }
}
